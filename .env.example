# Backend
APP_NAME=AI Document Manager
APP_ENV=development

DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@db:5432/ai_document_manager

# SECRET_KEY: bí mật ký JWT.
# Để trống = app tự sinh random mỗi lần khởi động.
# Nếu muốn token ổn định giữa các lần restart, tự tạo một lần rồi dán vào:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Chỉ bật =true khi dev:
# forgot-password sẽ trả reset token/link trực tiếp trong response.
EXPOSE_RESET_TOKEN=false

VECTOR_DB_URL=http://vector-db:6333
LLM_API_KEY=

STORAGE_PATH=storage/uploads
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8000
MAX_UPLOAD_SIZE=104857600

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=ai_document_manager

# pgAdmin
PGADMIN_EMAIL=your-email@example.com
PGADMIN_PASSWORD=YOUR_PGADMIN_PASSWORD
PGADMIN_MASTER_PASSWORD=YOUR_PGADMIN_MASTER_PASSWORD