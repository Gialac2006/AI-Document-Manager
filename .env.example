# Backend
APP_NAME=AI Document Manager
APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@db:5432/ai_document_manager
# SECRET_KEY: tạo chuỗi ngẫu nhiên (vd: python -c "import secrets; print(secrets.token_hex(32))").
# Nếu để trống, app tự sinh ngẫu nhiên khi khởi động (token sẽ bị vô hiệu mỗi lần restart).
SECRET_KEY=generated-by-secrets.token_hex(32)
VECTOR_DB_URL=http://vector-db:6333
LLM_API_KEY=
STORAGE_PATH=storage/uploads
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8000
MAX_UPLOAD_SIZE=104857600

# Database (dùng cho container db trong compose.yaml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_document_manager
